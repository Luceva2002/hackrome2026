# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
# Solo per gli script (seed, pipeline): MAI nel browser, mai committata
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox (mappa + geocoding della pipeline)
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token

# LLM della pipeline (mapping, PDF, match ambigui) — Vercel AI SDK
ANTHROPIC_API_KEY=
PIPELINE_MODEL=claude-sonnet-5-5

# Agente vocale ElevenLabs (client tools)
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Account demo creati da `npm run db:seed` (cambiale prima di un deploy pubblico)
DEMO_CITIZEN_EMAIL=cittadino@demo.romaincampo.it
DEMO_CITIZEN_PASSWORD=Demo-Cittadino-2026
DEMO_MANAGER_EMAIL=gestore@demo.romaincampo.it
DEMO_MANAGER_PASSWORD=Demo-Gestore-2026
DEMO_ADMIN_EMAIL=admin@demo.romaincampo.it
DEMO_ADMIN_PASSWORD=Demo-Admin-2026
